{
  "name": "norn",
  "version": "0.0.0",
  "description": "Norn, the coordination language for teams of people and AI agents",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/norn-lang/norn.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "norn": "src/cli.ts"
  },
  "scripts": {
    "norn": "node src/cli.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p playground",
    "playground:build": "node playground/build.ts",
    "playground:dev": "node playground/build.ts --serve"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
